root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
max_line_length = 100

[*.sh]
indent_size = 4

[*.toml]
indent_size = 4

[*.{yml,yaml,md}]
indent_size = 2

# Markdown line breaks are trailing-space significant; don't strip them.
[*.md]
trim_trailing_whitespace = false

# Generated / vendored / fixture content — leave byte-for-byte.
[{Cargo.lock,*.pem}]
insert_final_newline = unset
trim_trailing_whitespace = unset
